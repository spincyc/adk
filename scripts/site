#!/usr/bin/env python3
"""Stage, validate, build, and preview the ADK documentation site."""

from __future__ import annotations

import argparse
import hashlib
import shutil
import subprocess
import sys
from html.parser import HTMLParser
from pathlib import Path
from urllib.parse import unquote, urlsplit

import markdown


ROOT = Path(__file__).resolve().parents[1]
BUILD_ROOT = ROOT / "build"
SOURCE_ROOT = BUILD_ROOT / "site-source"
SITE_ROOT = BUILD_ROOT / "site"
CONFIG = ROOT / "mkdocs.yml"
MAX_LINKED_DESIGN_DOCUMENTS = 256


class SiteError(RuntimeError):
    """A site input or tool problem that requires attention."""


def reject_draft_leaks(
    draft_root: Path | None = None,
    staged_root: Path | None = None,
) -> None:
    """Reject exact draft artifacts copied or renamed into the staged site."""
    draft_root = draft_root or ROOT / "docs/design/drafts"
    staged_root = staged_root or SOURCE_ROOT
    if not draft_root.is_dir():
        return

    draft_digests: dict[bytes, Path] = {}
    for source in sorted(path for path in draft_root.rglob("*") if path.is_file()):
        digest = hashlib.sha256(source.read_bytes()).digest()
        draft_digests[digest] = source

    for staged in sorted(path for path in staged_root.rglob("*") if path.is_file()):
        digest = hashlib.sha256(staged.read_bytes()).digest()
        source = draft_digests.get(digest)
        if source is not None:
            raise SiteError(
                "noncanonical draft entered staged site: "
                f"{source} -> {staged}"
            )


def copy_tree(source: Path, destination: Path, *, required: bool = True) -> None:
    if not source.is_dir():
        if required:
            raise SiteError(f"missing site input directory: {source.relative_to(ROOT)}")
        return
    shutil.copytree(source, destination, dirs_exist_ok=True)


class MarkdownLinkParser(HTMLParser):
    """Collect destinations from Markdown-rendered links."""

    def __init__(self) -> None:
        super().__init__()
        self.targets: list[str] = []

    def handle_starttag(
        self,
        tag: str,
        attributes: list[tuple[str, str | None]],
    ) -> None:
        if tag != "a":
            return
        for name, value in attributes:
            if name == "href" and value is not None:
                self.targets.append(value)


def markdown_link_targets(text: str) -> list[str]:
    parser = MarkdownLinkParser()
    parser.feed(
        markdown.markdown(
            text,
            extensions=("fenced_code",),
            output_format="html",
        )
    )
    return parser.targets


def stage_linked_design_documents(
    staged_documents: list[Path],
    source_design_root: Path,
    staged_docs_root: Path,
) -> None:
    """Stage the bounded closure of canonical Markdown links into docs/design."""
    source_design_root = source_design_root.resolve()
    source_draft_root = (source_design_root / "drafts").resolve()
    staged_design_root = (staged_docs_root / "design").resolve()
    pending = list(staged_documents)
    visited: set[Path] = set()
    staged_design: set[Path] = set()

    while pending:
        document = pending.pop()
        try:
            resolved_document = document.resolve(strict=True)
        except OSError:
            continue
        if resolved_document in visited:
            continue
        visited.add(resolved_document)

        text = resolved_document.read_text(encoding="utf-8")
        for raw_target in markdown_link_targets(text):
            try:
                parsed = urlsplit(raw_target)
            except ValueError:
                continue
            if parsed.scheme or parsed.netloc or not parsed.path:
                continue
            target = Path(unquote(parsed.path))
            if target.is_absolute() or target.suffix.lower() != ".md":
                continue
            try:
                staged_target = (
                    resolved_document.parent / target
                ).resolve()
                relative_design_path = staged_target.relative_to(staged_design_root)
                source_target = (
                    source_design_root / relative_design_path
                ).resolve(strict=True)
                source_target.relative_to(source_design_root)
            except (OSError, ValueError):
                continue
            if (
                source_target == source_draft_root
                or source_draft_root in source_target.parents
            ):
                continue
            if not source_target.is_file():
                continue

            if source_target not in staged_design:
                if len(staged_design) >= MAX_LINKED_DESIGN_DOCUMENTS:
                    raise SiteError(
                        "linked design-document closure exceeds "
                        f"{MAX_LINKED_DESIGN_DOCUMENTS} files"
                    )
                destination = staged_docs_root / "design" / relative_design_path
                destination.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(source_target, destination)
                staged_design.add(source_target)
            pending.append(staged_target)


def copy_lesson_materials() -> None:
    """Publish reviewed lessons at stable, human-readable download paths."""
    lesson_pdfs = sorted((ROOT / "doc/lessons").glob("*.pdf"))
    sketches = sorted((ROOT / "examples").glob("*/*.ino"))
    sources = sorted((ROOT / "docs/lessons").glob("*/main.tex"))

    for source in lesson_pdfs:
        destination = SOURCE_ROOT / "downloads/lessons" / source.name
        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source, destination)
    for source in sketches:
        destination = SOURCE_ROOT / "downloads/sketches" / source.name
        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source, destination)
    for source in sources:
        destination = (
            SOURCE_ROOT
            / "downloads/sources/lessons"
            / source.parent.name
            / "main.tex"
        )
        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source, destination)
    copy_tree(
        ROOT / "docs/lessons/assets",
        SOURCE_ROOT / "downloads/assets",
        required=False,
    )
    copy_tree(
        ROOT / "docs/lessons/assets",
        SOURCE_ROOT / "downloads/sources/lessons/assets",
        required=False,
    )
    copy_tree(
        ROOT / "legacy/doc/lessons",
        SOURCE_ROOT / "downloads/legacy/lessons",
        required=False,
    )
    for source in sorted((ROOT / "legacy/lessons").glob("*/*.ino.txt")):
        destination = (
            SOURCE_ROOT
            / "downloads/legacy/sketches"
            / source.name.removesuffix (".txt")
        )
        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source, destination)
    for source in sorted((ROOT / "legacy/docs/lessons").glob("*/main.tex")):
        destination = (
            SOURCE_ROOT
            / "downloads/legacy/sources/lessons"
            / source.parent.name
            / "main.tex"
        )
        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source, destination)
    copy_tree(
        ROOT / "legacy/docs/lessons/assets",
        SOURCE_ROOT / "downloads/legacy/sources/lessons/assets",
        required=False,
    )


def stage() -> None:
    """Assemble the explicitly publishable tree consumed by MkDocs."""
    readme = ROOT / "README.md"
    if not CONFIG.is_file():
        raise SiteError("missing MkDocs configuration: mkdocs.yml")
    if not readme.is_file():
        raise SiteError("missing site landing source: README.md")

    if SOURCE_ROOT.exists():
        shutil.rmtree(SOURCE_ROOT)
    SOURCE_ROOT.mkdir(parents=True)

    shutil.copy2(readme, SOURCE_ROOT / "index.md")
    license_lines = (ROOT / "LICENSE").read_text(encoding="utf-8").splitlines()
    license_body = "\n".join(license_lines[1:]).lstrip()
    (SOURCE_ROOT / "license.md").write_text(
        f"# MIT License\n\n{license_body}\n",
        encoding="utf-8",
    )
    canonical_docs = (
        "ARCHITECTURE.md",
        "CLI.md",
        "COMPONENTS.md",
        "COMPARABLE_PROJECTS.md",
        "CURRICULUM.md",
        "DEVELOPMENT.md",
        "MEGA_ADC_NOTES.md",
        "NETWORK_MATRIX_CONSTRAINTS.md",
        "PACKAGING.md",
        "PDF_POLICY.md",
        "PROJECTS.md",
        "ROADMAP.md",
        "SAFETY_MODEL.md",
        "SIZE_BUDGETS.md",
        "STYLE.md",
        "TESTING.md",
        "TOOLS.md",
        "WORK_QUEUE.md",
    )
    for name in canonical_docs:
        source = ROOT / "docs" / name
        destination = SOURCE_ROOT / "docs" / name
        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source, destination)
    for project in sorted((ROOT / "docs/projects").glob("*.md")):
        destination = SOURCE_ROOT / "docs/projects" / project.name
        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(project, destination)
    historical_design_documents = (
        "CANONICAL_PUBLICATION_COUPLING_STRESS_PASS.md",
        "ELEGOO_MEGA_KIT_COVERAGE_2026-07-27.md",
        "KIT_MODULE_SAFETY_TAXONOMY.md",
        "LESSONS_022_024.md",
        "LESSONS_025_027_TELEMETRY.md",
        "LESSONS_028_030.md",
        "LESSONS_031_033_INPUT_EXPANSION_PLAN.md",
        "LESSONS_034_036_MAGNETIC_PASSAGE_PLAN.md",
        "LESSONS_037_039_PERCUSSION_PLAN.md",
        "LESSONS_040_042_OPTICAL_COURSE_MARSHAL_PLAN.md",
        "LESSONS_043_045_BALANCE_TABLE_PLAN.md",
        "LESSONS_046_048_KINETIC_SCULPTURE_PLAN.md",
        "LESSONS_049_051_PARTS_CAROUSEL_PLAN.md",
        "LESSONS_052_054_IR_TRANSLATOR_PLAN.md",
        "LESSON_049_IDENTITY_STRESS_PASS.md",
        "LESSON_050_HOMING_STRESS_PASS.md",
        "LESSON_051_CAROUSEL_STRESS_PASS.md",
        "LESSON_052_CAPTURE_EVIDENCE_STRESS_PASS.md",
        "LESSON_053_KNOWN_IR_EMISSION_STRESS_PASS.md",
        "LESSON_054_IR_TRANSLATOR_STRESS_PASS.md",
    )
    for name in historical_design_documents:
        source = ROOT / "docs/design" / name
        destination = SOURCE_ROOT / "docs/design" / name
        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source, destination)
    acceptance_template = ROOT / "docs/templates/hardware-acceptance.md"
    acceptance_destination = (
        SOURCE_ROOT / "docs/templates/hardware-acceptance.md"
    )
    acceptance_destination.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(acceptance_template, acceptance_destination)
    stress_template = ROOT / "docs/templates/component-design-stress-pass.md"
    stress_destination = (
        SOURCE_ROOT / "docs/templates/component-design-stress-pass.md"
    )
    shutil.copy2(stress_template, stress_destination)
    copy_tree(
        ROOT / "docs/research",
        SOURCE_ROOT / "docs/research",
        required=False,
    )
    copy_tree(
        ROOT / "docs/inventory",
        SOURCE_ROOT / "docs/inventory",
        required=False,
    )
    copy_tree(
        ROOT / "docs/audits",
        SOURCE_ROOT / "docs/audits",
        required=False,
    )
    copy_tree(ROOT / "site/pages", SOURCE_ROOT, required=False)
    shutil.copy2(readme, SOURCE_ROOT / "index.md")
    stage_linked_design_documents(
        list(SOURCE_ROOT.rglob("*.md")),
        ROOT / "docs/design",
        SOURCE_ROOT / "docs",
    )
    published_lessons = {
        source.stem for source in (ROOT / "doc/lessons").glob("*.pdf")
    }
    for page in (SOURCE_ROOT / "lessons").glob("[0-9][0-9][0-9].md"):
        if page.stem not in published_lessons:
            page.unlink()
    copy_tree(ROOT / "site/assets", SOURCE_ROOT / "assets")
    copy_lesson_materials()
    reject_draft_leaks()


def mkdocs(*arguments: str) -> None:
    executable = shutil.which("mkdocs")
    if executable is None:
        raise SiteError(
            "mkdocs is required; on Arch Linux run 'make bootstrap-packages'"
        )
    command = [executable, *arguments, "--config-file", str(CONFIG)]
    result = subprocess.run(command, cwd=ROOT, check=False)
    if result.returncode != 0:
        raise SiteError(f"MkDocs exited with status {result.returncode}")


def check() -> None:
    stage()
    mkdocs("build", "--strict", "--site-dir", str(SITE_ROOT))
    checker = ROOT / "scripts/check_site.py"
    result = subprocess.run(
        [sys.executable, str(checker), str(SITE_ROOT)],
        cwd=ROOT,
        check=False,
    )
    if result.returncode != 0:
        raise SiteError(f"site checker exited with status {result.returncode}")
    print("site: built and validated the publishable artifact")


def build() -> None:
    stage()
    mkdocs("build", "--strict", "--site-dir", str(SITE_ROOT))
    print(f"site: built {SITE_ROOT.relative_to(ROOT)}")


def serve(port: int) -> None:
    stage()
    mkdocs("serve", "--strict", "--dev-addr", f"127.0.0.1:{port}")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser("check", help="stage and validate a strict site build")
    subparsers.add_parser("build", help="build the publishable site artifact")
    preview = subparsers.add_parser("serve", help="serve a local live preview")
    preview.add_argument("--port", type=int, default=8000)
    arguments = parser.parse_args()

    try:
        if arguments.command == "check":
            check()
        elif arguments.command == "build":
            build()
        else:
            serve(arguments.port)
    except SiteError as error:
        print(f"site: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
